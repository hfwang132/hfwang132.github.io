# Local credentials (never commit Zhihu cookies).
.secrets/

# Unpublished Hugo content. This directory is loaded only by the local
# draft-preview configuration and must never be committed.
private-content/

# Local copies of external source projects (for example, the Overleaf CV).
.external/

# Python
.venv/
__pycache__/
*.py[cod]

# Hugo local output and caches. Local deployment publishes only the generated
# site to the gh-pages branch.
.hugo_build.lock
.hugo-cache/
public/
cloudflare-public/
resources/_gen/

# Local credentials (never commit Zhihu cookies).
.secrets/

# Local deployment tooling and Vercel project linkage/build output.
.tools/
.vercel/

# Unpublished Hugo content. This directory is loaded only by the local
# draft-preview configuration and must never be committed.
private-content/

# Local copies of external source projects (for example, the Overleaf CV).
.external/

# Python
.venv/
__pycache__/
*.py[cod]

# Hugo local output and caches. Local deployment uploads only the generated
# static site to Vercel.
.hugo_build.lock
.hugo-cache/
public/
cloudflare-public/
resources/_gen/
.env.local
